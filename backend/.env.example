# SQLite database file, relative to this prisma/ directory.
DATABASE_URL="file:./dev.db"

# Required — the backend refuses to start without this set (see main.ts).
# Generate a real random value for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The packaged Electron app does not use this file — it generates and
# persists its own random secret per install (see electron/main.ts).
JWT_SECRET="change-me-to-a-long-random-value"

JWT_EXPIRES_IN="7d"
PORT=3009
