generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANCY
// ============================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // short slug shown in the pre-login company selector
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations — one row per tenant-scoped model in the app.
  users                User[]
  roles                Role[]
  customers            Customer[]
  suppliers            Supplier[]
  gasProducts          GasProduct[]
  storageTanks         StorageTank[]
  purchases            Purchase[]
  gasReceivings        GasReceiving[]
  gasInventoryTxns     GasInventoryTransaction[]
  cylinderTypes        CylinderType[]
  cylinderInventory    CylinderInventory[]
  cylinderTransactions CylinderTransaction[]
  fillingBatches       FillingBatch[]
  sales                Sale[]
  saleItems            SaleItem[]
  saleReturns          SaleReturn[]
  saleReturnItems      SaleReturnItem[]
  customerCylinderBals CustomerCylinderBalance[]
  customerPayments     CustomerPayment[]
  supplierPayments     SupplierPayment[]
  expenses             Expense[]
  cashTransactions     CashTransaction[]
  bankTransactions     BankTransaction[]
  auditLogs            AuditLog[]
  settings             Setting[]
  drivers              Driver[]
  vehicles             Vehicle[]
  deliveries           Delivery[]
  cylinderUnits        CylinderUnit[]

  @@map("companies")
}

// ============================================================
// ACCESS CONTROL
// ============================================================

model User {
  id           String   @id @default(cuid())
  companyId    String? // null only for super-admin accounts (see isSuperAdmin)
  username     String
  email        String
  passwordHash String
  fullName     String
  role         String   @default("SALES")
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  company          Company?                  @relation(fields: [companyId], references: [id])
  fillingBatches   FillingBatch[]
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]
  sales            Sale[]
  auditLogs        AuditLog[]
  gasInventoryTxns GasInventoryTransaction[]
  cylinderTxns     CylinderTransaction[]
  gasReceivings    GasReceiving[]

  @@unique([companyId, username])
  @@unique([companyId, email])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  permissions String  @default("[]") // JSON array of permission strings

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("roles")
}

// ============================================================
// PARTIES
// ============================================================

model Customer {
  id             String   @id @default(cuid())
  companyId      String
  customerCode   String
  businessName   String
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  customerType   String   @default("RETAIL") // RETAIL, DEALER, COMMERCIAL, INDIVIDUAL
  creditLimit    Float    @default(0)
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)
  paymentTerms   Int      @default(0) // days
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  company              Company                   @relation(fields: [companyId], references: [id])
  sales                Sale[]
  customerPayments     CustomerPayment[]
  customerCylinderBals CustomerCylinderBalance[]
  cylinderTransactions CylinderTransaction[]
  saleReturns          SaleReturn[]
  deliveries           Delivery[]
  cylinderUnits        CylinderUnit[]

  @@unique([companyId, customerCode])
  @@index([companyId, status])
  @@map("customers")
}

model Supplier {
  id             String   @id @default(cuid())
  companyId      String
  supplierCode   String
  supplierName   String
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  taxNtn         String?
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)
  paymentTerms   Int      @default(0)
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  company          Company           @relation(fields: [companyId], references: [id])
  purchases        Purchase[]
  gasReceivings    GasReceiving[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, supplierCode])
  @@index([companyId, status])
  @@map("suppliers")
}

// ============================================================
// GAS PRODUCTS & TANKS
// ============================================================

model GasProduct {
  id                  String @id @default(cuid())
  companyId           String
  productCode         String
  productName         String
  gasType             String // LPG, CNG, etc.
  unit                String @default("KG")
  defaultPurchaseRate Float  @default(0)
  defaultSellingRate  Float  @default(0)
  minStockLevel       Float  @default(0)
  status              String @default("ACTIVE")

  // Relations
  company          Company                   @relation(fields: [companyId], references: [id])
  storageTanks     StorageTank[]
  purchases        Purchase[]
  gasInventoryTxns GasInventoryTransaction[]

  @@unique([companyId, productCode])
  @@index([companyId, status])
  @@map("gas_products")
}

model StorageTank {
  id              String  @id @default(cuid())
  companyId       String
  tankNumber      String
  tankName        String
  gasProductId    String
  capacity        Float
  currentQuantity Float   @default(0)
  location        String?
  status          String  @default("ACTIVE")

  // Relations
  company          Company                   @relation(fields: [companyId], references: [id])
  gasProduct       GasProduct                @relation(fields: [gasProductId], references: [id])
  gasReceivings    GasReceiving[]
  fillingBatches   FillingBatch[]
  gasInventoryTxns GasInventoryTransaction[]

  @@unique([companyId, tankNumber])
  @@index([companyId, status])
  @@map("storage_tanks")
}

// ============================================================
// PURCHASES
// ============================================================

model Purchase {
  id                    String   @id @default(cuid())
  companyId             String
  purchaseNumber        String
  supplierId            String
  gasProductId          String
  purchaseDate          DateTime
  quantity              Float
  unit                  String   @default("KG")
  purchaseRate          Float
  gasAmount             Float
  transportation        Float    @default(0)
  otherCharges          Float    @default(0)
  discount              Float    @default(0)
  grossAmount           Float
  netAmount             Float
  paidAmount            Float    @default(0)
  remainingAmount       Float
  paymentStatus         String   @default("UNPAID") // UNPAID, PARTIAL, PAID
  supplierInvoiceNumber String?
  notes                 String?
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  company          Company           @relation(fields: [companyId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  gasProduct       GasProduct        @relation(fields: [gasProductId], references: [id])
  gasReceivings    GasReceiving[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, purchaseNumber])
  @@index([companyId, purchaseDate])
  @@index([companyId, paymentStatus])
  @@map("purchases")
}

model GasReceiving {
  id               String   @id @default(cuid())
  companyId        String
  receivingNumber  String
  purchaseId       String
  supplierId       String
  receivingDate    DateTime
  expectedQuantity Float
  receivedQuantity Float
  variance         Float    @default(0)
  unit             String   @default("KG")
  tankId           String
  receivedById     String?
  notes            String?
  createdAt        DateTime @default(now())

  // Relations
  company    Company     @relation(fields: [companyId], references: [id])
  purchase   Purchase    @relation(fields: [purchaseId], references: [id])
  supplier   Supplier    @relation(fields: [supplierId], references: [id])
  tank       StorageTank @relation(fields: [tankId], references: [id])
  receivedBy User?       @relation(fields: [receivedById], references: [id])

  @@unique([companyId, receivingNumber])
  @@index([companyId, receivingDate])
  @@map("gas_receivings")
}

// ============================================================
// INVENTORY
// ============================================================

model GasInventoryTransaction {
  id              String   @id @default(cuid())
  companyId       String
  transactionType String // PURCHASE, RECEIVING, FILLING, ADJUSTMENT, LOSS
  referenceId     String?
  referenceType   String?
  tankId          String
  gasProductId    String
  quantity        Float
  previousStock   Float
  newStock        Float
  notes           String?
  createdAt       DateTime @default(now())
  createdById     String?

  // Relations
  company    Company     @relation(fields: [companyId], references: [id])
  tank       StorageTank @relation(fields: [tankId], references: [id])
  gasProduct GasProduct  @relation(fields: [gasProductId], references: [id])
  createdBy  User?       @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([tankId])
  @@map("gas_inventory_transactions")
}

// ============================================================
// CYLINDERS
// ============================================================

model CylinderType {
  id            String @id @default(cuid())
  companyId     String
  cylinderSize  String // e.g., "11.8 KG", "45 KG"
  gasCapacity   Float
  emptyWeight   Float
  depositAmount Float  @default(0)
  status        String @default("ACTIVE")
  sellingPrices String @default("[]") // JSON array of {priceType, price}

  // Relations
  company              Company                   @relation(fields: [companyId], references: [id])
  cylinderInventory    CylinderInventory[]
  cylinderTransactions CylinderTransaction[]
  fillingBatches       FillingBatch[]
  saleItems            SaleItem[]
  saleReturnItems      SaleReturnItem[]
  customerCylinderBals CustomerCylinderBalance[]
  cylinderUnits        CylinderUnit[]

  @@index([companyId, status])
  @@map("cylinder_types")
}

model CylinderInventory {
  id             String   @id @default(cuid())
  companyId      String
  cylinderTypeId String
  status         String // FILLED, EMPTY, WITH_CUSTOMER, DAMAGED, MAINTENANCE, LOST
  quantity       Int      @default(0)
  updatedAt      DateTime @updatedAt

  // Relations
  company      Company      @relation(fields: [companyId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])

  @@unique([cylinderTypeId, status])
  @@index([companyId])
  @@map("cylinder_inventory")
}

model CylinderTransaction {
  id              String   @id @default(cuid())
  companyId       String
  transactionType String
  referenceId     String?
  cylinderTypeId  String
  quantity        Int
  fromStatus      String?
  toStatus        String?
  customerId      String?
  notes           String?
  createdAt       DateTime @default(now())
  createdById     String?

  // Relations
  company      Company      @relation(fields: [companyId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([cylinderTypeId])
  @@map("cylinder_transactions")
}

model FillingBatch {
  id                String   @id @default(cuid())
  companyId         String
  batchNumber       String
  fillingDate       DateTime
  tankId            String
  cylinderTypeId    String
  numberOfCylinders Int
  expectedGasQty    Float
  actualGasQty      Float    @default(0)
  gasVariance       Float    @default(0)
  operatorId        String?
  fillingStation    String?
  status            String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  notes             String?
  createdAt         DateTime @default(now())

  // Relations
  company      Company      @relation(fields: [companyId], references: [id])
  tank         StorageTank  @relation(fields: [tankId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])
  operator     User?        @relation(fields: [operatorId], references: [id])

  @@unique([companyId, batchNumber])
  @@index([companyId, fillingDate])
  @@index([companyId, status])
  @@map("filling_batches")
}

// ============================================================
// SALES
// ============================================================

model Sale {
  id              String   @id @default(cuid())
  companyId       String
  invoiceNumber   String
  customerId      String
  saleDate        DateTime
  subtotal        Float
  discount        Float    @default(0)
  netTotal        Float
  paidAmount      Float    @default(0)
  remainingAmount Float    @default(0)
  paymentMethod   String   @default("CASH") // CASH, CREDIT, BANK, CHEQUE, ONLINE
  paymentStatus   String   @default("UNPAID") // UNPAID, PARTIAL, PAID
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  company     Company           @relation(fields: [companyId], references: [id])
  customer    Customer          @relation(fields: [customerId], references: [id])
  createdBy   User?             @relation(fields: [createdById], references: [id])
  saleItems   SaleItem[]
  saleReturns SaleReturn[]
  payments    CustomerPayment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, saleDate])
  @@index([companyId, paymentStatus])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id             String @id @default(cuid())
  companyId      String
  saleId         String
  cylinderTypeId String
  quantity       Int
  unitPrice      Float
  discount       Float  @default(0)
  totalPrice     Float

  // Relations
  company         Company          @relation(fields: [companyId], references: [id])
  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cylinderType    CylinderType     @relation(fields: [cylinderTypeId], references: [id])
  saleReturnItems SaleReturnItem[]

  @@index([companyId])
  @@index([saleId])
  @@map("sale_items")
}

model SaleReturn {
  id           String   @id @default(cuid())
  companyId    String
  returnNumber String
  saleId       String
  customerId   String
  returnDate   DateTime
  reason       String?
  totalAmount  Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())

  // Relations
  company  Company          @relation(fields: [companyId], references: [id])
  sale     Sale             @relation(fields: [saleId], references: [id])
  customer Customer         @relation(fields: [customerId], references: [id])
  items    SaleReturnItem[]

  @@unique([companyId, returnNumber])
  @@index([companyId, returnDate])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id             String @id @default(cuid())
  companyId      String
  saleReturnId   String
  saleItemId     String
  cylinderTypeId String
  quantity       Int
  unitPrice      Float
  totalPrice     Float

  // Relations
  company      Company      @relation(fields: [companyId], references: [id])
  saleReturn   SaleReturn   @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem     @relation(fields: [saleItemId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])

  @@index([companyId])
  @@index([saleReturnId])
  @@map("sale_return_items")
}

model CustomerCylinderBalance {
  id             String   @id @default(cuid())
  companyId      String
  customerId     String
  cylinderTypeId String
  filledQty      Int      @default(0)
  emptyQty       Int      @default(0)
  totalQty       Int      @default(0)
  updatedAt      DateTime @updatedAt

  // Relations
  company      Company      @relation(fields: [companyId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])

  @@unique([customerId, cylinderTypeId])
  @@index([companyId])
  @@map("customer_cylinder_balances")
}

// ============================================================
// FINANCE
// ============================================================

model CustomerPayment {
  id            String   @id @default(cuid())
  companyId     String
  paymentNumber String
  customerId    String
  saleId        String?
  paymentDate   DateTime
  amount        Float
  paymentMethod String   @default("CASH")
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  createdById   String?

  // Relations
  company   Company  @relation(fields: [companyId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  sale      Sale?    @relation(fields: [saleId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@unique([companyId, paymentNumber])
  @@index([companyId, paymentDate])
  @@index([customerId])
  @@map("customer_payments")
}

model SupplierPayment {
  id            String   @id @default(cuid())
  companyId     String
  paymentNumber String
  supplierId    String
  purchaseId    String?
  paymentDate   DateTime
  amount        Float
  paymentMethod String   @default("CASH")
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  createdById   String?

  // Relations
  company   Company   @relation(fields: [companyId], references: [id])
  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  purchase  Purchase? @relation(fields: [purchaseId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@unique([companyId, paymentNumber])
  @@index([companyId, paymentDate])
  @@index([supplierId])
  @@map("supplier_payments")
}

model Expense {
  id            String   @id @default(cuid())
  companyId     String
  expenseNumber String
  category      String // TRANSPORTATION, FUEL, SALARIES, ELECTRICITY, RENT, MAINTENANCE, LOADING_UNLOADING, CYLINDER_REPAIR, OFFICE, OTHER
  expenseDate   DateTime
  amount        Float
  paymentMethod String   @default("CASH")
  description   String?
  attachment    String?
  createdAt     DateTime @default(now())
  createdById   String?

  // Relations
  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@unique([companyId, expenseNumber])
  @@index([companyId, expenseDate])
  @@index([companyId, category])
  @@map("expenses")
}

model CashTransaction {
  id              String   @id @default(cuid())
  companyId       String
  transactionType String
  referenceId     String?
  referenceType   String?
  amount          Float
  direction       String // IN, OUT
  balance         Float
  description     String?
  createdAt       DateTime @default(now())

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("cash_transactions")
}

model BankTransaction {
  id              String   @id @default(cuid())
  companyId       String
  transactionType String
  referenceId     String?
  referenceType   String?
  amount          Float
  direction       String // IN, OUT
  balance         Float
  bankName        String?
  accountNumber   String?
  description     String?
  createdAt       DateTime @default(now())

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("bank_transactions")
}

// ============================================================
// SYSTEM
// ============================================================

model AuditLog {
  id            String   @id @default(cuid())
  companyId     String? // null for super-admin/system-level actions (e.g. creating a company, DB backup)
  userId        String?
  action        String
  module        String
  recordId      String?
  previousValue String? // JSON
  newValue      String? // JSON
  ipAddress     String?
  createdAt     DateTime @default(now())

  // Relations
  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, module])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@map("settings")
}

// ============================================================
// DELIVERY MANAGEMENT
// ============================================================

model Driver {
  id            String   @id @default(cuid())
  companyId     String
  driverCode    String
  fullName      String
  phone         String
  licenseNumber String?
  address       String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id])
  deliveries Delivery[]

  @@unique([companyId, driverCode])
  @@index([companyId, status])
  @@map("drivers")
}

model Vehicle {
  id            String   @id @default(cuid())
  companyId     String
  vehicleCode   String
  vehicleNumber String
  vehicleType   String   @default("TRUCK")
  capacity      Float    @default(0)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id])
  deliveries Delivery[]

  @@unique([companyId, vehicleCode])
  @@unique([companyId, vehicleNumber])
  @@index([companyId, status])
  @@map("vehicles")
}

model Delivery {
  id             String   @id @default(cuid())
  companyId      String
  deliveryNumber String
  customerId     String
  saleId         String?
  driverId       String?
  vehicleId      String?
  deliveryDate   DateTime
  status         String   @default("PENDING")
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  driver   Driver?  @relation(fields: [driverId], references: [id])
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id])

  @@unique([companyId, deliveryNumber])
  @@index([companyId, status])
  @@index([customerId])
  @@map("deliveries")
}

// ============================================================
// INDIVIDUAL CYLINDER TRACKING
// ============================================================

model CylinderUnit {
  id             String    @id @default(cuid())
  companyId      String
  serialNumber   String
  qrCode         String
  cylinderTypeId String
  status         String    @default("EMPTY")
  customerId     String?
  purchaseDate   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company      @relation(fields: [companyId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])

  @@unique([companyId, serialNumber])
  @@unique([companyId, qrCode])
  @@index([companyId, status])
  @@map("cylinder_units")
}
