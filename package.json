{
  "name": "abyte-distribix",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "electron"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:electron": "npm run build --workspace=electron",
    "build:all": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "package:win": "npm run build:all && cd electron && npx electron-builder --win"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "electron@28.3.3": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
