{
  "name": "@abyte/electron",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "electron-builder": "^24.9.1",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.abyte.distribix",
    "productName": "AbyteDistribix",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
